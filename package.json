{
  "name": "opencode-v2-mcp-bridge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.mjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "description": "MCP bridge for OpenCode V2: run OpenCode agents with a chosen model from Cursor or any MCP client",
  "license": "MIT",
  "bin": {
    "opencode-mcp-bridge": "dist/index.mjs"
  },
  "scripts": {
    "build": "esbuild src/index.mjs --bundle --platform=node --format=esm --outfile=dist/index.mjs"
  },
  "files": [
    "dist",
    "src",
    "run.sh",
    "run.cmd",
    "install.sh",
    "README.md",
    "LICENSE",
    "agents",
    "examples"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "opencode",
    "cursor",
    "subagent",
    "agents",
    "model-context-protocol"
  ]
}